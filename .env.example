# Database
POSTGRES_DB=adaptive_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cloud deploys: set this instead of the POSTGRES_* parts above.
# When present it takes precedence over them.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to 0 to skip the automatic migrate + seed on container start.
# AUTO_MIGRATE=1

# LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=groq

# Search
SEARXNG_URL=http://searxng:8080

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Extra allowed CORS origins, comma-separated. localhost:5173 and
# localhost:3000 are always permitted; add deployed frontend URLs here.
# CORS_ORIGINS=https://your-frontend.vercel.app
