# Base URL of the FastAPI backend.
#
# Local Docker:  http://localhost:8000
# Deployed:      set this in the Vercel project's environment variables to the
#                Render service URL, e.g. https://adaptive-tutor-api.onrender.com
#
# Vite inlines VITE_* variables at build time, so changing this requires a
# redeploy, not just a restart.
VITE_API_URL=http://localhost:8000
